# .env.fast - Speed up assessments for testing
# Set much lower timeouts for quick testing

# Tool Timeouts (in seconds)
REDAGENT_NMAP_TIMEOUT=30          # Default: 120 (scan fast hosts only)
REDAGENT_SQLMAP_TIMEOUT=15        # Default: 60 (quick test)
REDAGENT_HYDRA_TIMEOUT=30         # Default: 180 (quick brute force)
REDAGENT_CURL_TIMEOUT=10          # Default: 20 (quick HTTP checks)

# LLM Settings
REDAGENT_LLM_TIMEOUT=60           # Default: 600 (faster responses)
REDAGENT_LLM_MODEL=phi            # Use faster model

# Agent Settings
REDAGENT_MAX_STEPS=8              # Default: 15 (fewer reasoning steps)
REDAGENT_MAX_LOOPS=1              # Default: 3 (fewer reflection loops)

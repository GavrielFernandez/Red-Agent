# ============================================================================
# RED AGENT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and customize for your environment
# The system will load these settings to override defaults

# ============================================================================
# LLM Configuration
# ============================================================================
REDAGENT_LLM_MODEL=phi
REDAGENT_LLM_URL=http://localhost:11434
REDAGENT_LLM_TEMP=0.3
REDAGENT_LLM_TIMEOUT=600
REDAGENT_LLM_FALLBACK=true

# ============================================================================
# Tool Configuration
# ============================================================================
REDAGENT_NMAP_TIMEOUT=120
REDAGENT_SQLMAP_TIMEOUT=60
REDAGENT_HYDRA_TIMEOUT=180
REDAGENT_CURL_TIMEOUT=20
REDAGENT_TOOL_RETRIES=2
REDAGENT_TOOL_BACKOFF=1.5

# ============================================================================
# Dashboard Configuration
# ============================================================================
REDAGENT_DASHBOARD_HOST=0.0.0.0
REDAGENT_DASHBOARD_PORT=5000
REDAGENT_DASHBOARD_DEBUG=false
REDAGENT_SECRET_KEY=change-this-to-a-secure-key-in-production
REDAGENT_CORS_ORIGINS=*
REDAGENT_MAX_JOBS=5
REDAGENT_JOB_TIMEOUT=3600
REDAGENT_KEEP_HISTORY=50
REDAGENT_RATE_LIMIT=true
REDAGENT_RPM_LIMIT=60

# ============================================================================
# Agent Configuration
# ============================================================================
REDAGENT_MAX_STEPS=15
REDAGENT_MAX_LOOPS=3
REDAGENT_CONFIDENCE_THRESHOLD=0.6
REDAGENT_TARGET_TIMEOUT=3600

# Attack vectors (enable/disable specific attacks)
REDAGENT_RUN_SQLI=true
REDAGENT_RUN_XSS=true
REDAGENT_RUN_CMD=true
REDAGENT_RUN_PATH=true
REDAGENT_RUN_LDAP=true
REDAGENT_RUN_XXE=true
REDAGENT_RUN_HEADER=true
REDAGENT_RUN_BRUTE=true

# ============================================================================
# Logging Configuration
# ============================================================================
REDAGENT_LOG_DIR=./logs
REDAGENT_LOG_LEVEL=INFO
REDAGENT_FILE_LOGGING=true
REDAGENT_CONSOLE_LOGGING=true
REDAGENT_DETAILED_LOGS=true

# ============================================================================
# Security Configuration
# ============================================================================
REDAGENT_ENABLE_AUTH=false
# REDAGENT_API_KEY=your-api-key-here
REDAGENT_REQUIRE_HTTPS=true
REDAGENT_ALLOWED_HOSTS=localhost,127.0.0.1
REDAGENT_AUDIT_LOG=true
REDAGENT_SANITIZE_LOGS=true

# ============================================================================
# Environment & Debug
# ============================================================================
REDAGENT_ENV=development
REDAGENT_DEBUG=false
# ============================================================================
# OSINT API Keys (Enterprise Features)
# ============================================================================
# Shodan - Internet-wide port scanning data
# Get your key at: https://account.shodan.io/
SHODAN_API_KEY=

# VirusTotal - Malware and threat intelligence  
# Get your key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Censys - Certificate and host data
# Get your keys at: https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# SecurityTrails - DNS and domain history
# Get your key at: https://securitytrails.com/corp/api
SECURITYTRAILS_API_KEY=

# Hunter.io - Email finder
# Get your key at: https://hunter.io/api-keys
HUNTER_API_KEY=